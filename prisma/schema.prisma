// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions             Session[]
  accounts             Account[]
  wallets              Wallet[]
  categories           Category[]
  transactions         Transaction[]
  budgets              Budget[]
  budgetPeriodSetting  BudgetPeriodSetting?
  budgetPeriodOverrides BudgetPeriodOverride[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  idTokenExpiresAt      DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

enum WalletType {
  CASH
  BANK
  E_WALLET
  INVESTMENT
  SAVINGS
  OTHER
}

model Wallet {
  id                  String      @id @default(cuid())
  userId              String
  name                String
  type                WalletType  @default(BANK)
  balance             Decimal     @default(0) @db.Decimal(15, 2)
  currency            String      @default("IDR")
  color               String      @default("#0ea5e9")
  icon                String      @default("Wallet")
  isExcludedFromTotal Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        Transaction[] @relation("SourceWallet")
  transfersIn         Transaction[] @relation("DestinationWallet")

  @@index([userId])
  @@map("wallet")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model Category {
  id          String          @id @default(cuid())
  userId      String?
  parentId    String?
  name        String
  type        TransactionType @default(EXPENSE)
  icon        String          @default("Tag")
  color       String          @default("#64748b")
  isDefault   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[]      @relation("CategoryHierarchy")
  transactions Transaction[]
  budgets     Budget[]

  @@index([userId])
  @@index([parentId])
  @@map("category")
}

model Transaction {
  id                  String          @id @default(cuid())
  userId              String
  walletId            String
  destinationWalletId String?
  categoryId          String?
  type                TransactionType
  amount              Decimal         @db.Decimal(15, 2)
  date                DateTime        @default(now())
  note                String?         @db.Text
  attachmentUrl       String?         @db.Text
  // Client-chosen key that makes transaction creation idempotent: retrying a
  // save whose response was lost (e.g. proxy timeout after commit) reuses the
  // same key and returns the already-created row instead of duplicating.
  idempotencyKey      String?         @unique
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet              Wallet          @relation("SourceWallet", fields: [walletId], references: [id], onDelete: Cascade)
  destinationWallet   Wallet?         @relation("DestinationWallet", fields: [destinationWalletId], references: [id], onDelete: SetNull)
  category            Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([walletId])
  @@index([date])
  @@map("transaction")
}

model Budget {
  id          String    @id @default(cuid())
  userId      String
  categoryId  String
  amount      Decimal   @db.Decimal(15, 2)
  period      String    @default("MONTHLY")
  month       Int?      // 1-12 (optional, if null applies to recurring monthly)
  year        Int?      // e.g. 2026 (optional)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
  @@map("budget")
}

// ── Budget Period Setting ─────────────────────────────────────────────────────
// Global default for how a user's budget month starts.
// LAST_WORKING_DAY: start on the last Mon-Fri of the PREVIOUS calendar month.
// FIXED_DAY: start on a specific day-of-month (1–28) every month.
model BudgetPeriodSetting {
  id        String   @id @default(cuid())
  userId    String   @unique
  method    String   @default("LAST_WORKING_DAY") // "LAST_WORKING_DAY" | "FIXED_DAY"
  fixedDay  Int?     // 1-28, used when method = "FIXED_DAY"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("budget_period_setting")
}

// ── Budget Period Override ────────────────────────────────────────────────────
// Per-month override: force a specific start day for the budget period of
// a given (month, year). E.g. override June 2026 to start on day 28 (May 28).
model BudgetPeriodOverride {
  id        String   @id @default(cuid())
  userId    String
  month     Int      // budget month: 1–12
  year      Int      // budget year
  startDay  Int      // day-of-month when this budget month STARTS (in the prev calendar month)
  // startMonth is derived: always (month - 1), wrapping to Dec of (year - 1) if month = 1
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId])
  @@map("budget_period_override")
}
