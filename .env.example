# ==========================================
# Local Development Database URL (Host network)
# ==========================================
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/plankan"

# ==========================================
# Docker Production Database URL (sjo_default network)
# ==========================================
# DATABASE_URL="postgresql://USER:PASSWORD@postgres:5432/plankan"

# ==========================================
# Better Auth Configuration
# ==========================================
# Secret minimal 32 karakter. Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET="change-me-to-a-32-char-random-secret"
BETTER_AUTH_URL="https://budget.twogether.click"
NEXT_PUBLIC_APP_URL="https://budget.twogether.click"

# ==========================================
# Social Login (Google OAuth)
# ==========================================
# Buat OAuth 2.0 Client ID di https://console.cloud.google.com/apis/credentials
# Redirect URI: https://budget.twogether.click/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=accesskey
MINIO_SECRET_KEY=secretkey
MINIO_BUCKET=transactions

# ==========================================
# SMTP Configuration (Password Reset Email)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=PlanKan <no-reply@budget.twogether.click>

# ==========================================
# Receipt Upload Temp Storage (dev/prod)
# ==========================================
# Directory where uploaded receipt images are stored until the flow ends.
# Defaults to <project>/.tmp/receipts in dev; prod compose points this at /tmp.
RECEIPT_TMP_DIR=.tmp/receipts
# Sweep receipts older than this many ms (abandoned uploads). Default 86400000 (24h).
RECEIPT_MAX_AGE_MS=86400000

# ==========================================
# Google Gemini (OCR struk + input suara)
# ==========================================
# Kosongkan: OCR struk memakai item stub (dev) & fitur suara nonaktif (503).
# Ambil kunci di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ==========================================
# Monitoring (error, performance, AI cost)
# ==========================================
# Master switch — false menonaktifkan penulisan log monitoring.
MONITORING_ENABLED=true
# Email admin yang boleh mengakses halaman /monitoring.
# Dukung banyak admin: pisahkan dengan koma, mis. "a@x.com,b@x.com".
# Kosongkan untuk membuka ke semua user yang login (personal app single-owner).
MONITORING_OWNER_EMAIL=
# Retensi log (hari): ApiLog default 30, GeminiCallLog default 90.
MONITORING_RETENTION_DAYS=30
MONITORING_GEMINI_RETENTION_DAYS=90
# Harga token Gemini per 1M token (USD). Kosongkan untuk memakai tabel bawaan.
# Contoh: gemini-3.5-flash-lite default input=0.10, output=0.40
GEMINI_PRICE_INPUT_PER_M=
GEMINI_PRICE_OUTPUT_PER_M=